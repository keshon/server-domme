# .env
# Discord bot token
DISCORD_TOKEN=123

# Optional: comma-separated guild IDs to ignore
# Example: DISCORD_GUILD_BLACKLIST=123,456
DISCORD_GUILD_BLACKLIST=

# Optional: your Discord user ID. Runs every command on every server the bot
# is in, regardless of your roles there — so you can test admin commands
# without waiting on a server admin to grant you one. Treat it as a
# credential; leave it empty to disable it entirely.
DEVELOPER_ID=

# Storage directory (the datastore owns it: LOCK, write-ahead log, snapshots).
# One process at a time may open it.
# Default: ./data/store
STORAGE_PATH=./data/store

# Register Discord slash commands
INIT_SLASH_COMMANDS=true

# --- Session recovery / stability knobs ---

# If no gateway messages are received for this long, we treat the session as unhealthy.
# Default: 2m
WS_SILENCE_TIMEOUT=2m

# What to do when watchdog/API probe marks the session unhealthy:
# - restart-session: restart the Discord gateway session
# - ignore: do nothing (only log warnings)
DISCORD_UNHEALTHY_MODE=restart-session

# In restart mode: ignore the first N unhealthy signals within the window.
# Default: 0
DISCORD_UNHEALTHY_GRACE=0

# Counting window for DISCORD_UNHEALTHY_GRACE.
# Default: 1m
DISCORD_UNHEALTHY_WINDOW=1m

# --- Command execution guardrails ---

# Hard timeout for a single command execution.
# Default: 30s
COMMAND_TIMEOUT=30s

# Maximum number of concurrently running command handlers.
# Default: 16
COMMAND_PARALLELISM=16

# --- Logging (zerolog) ---

# Level: trace, debug, info, warn, error, fatal, panic
LOG_LEVEL=info

# Optional JSON log file with rotation; leave empty for stderr-only (pretty console).
# LOG_FILE=./logs/server-domme.json

LOG_MAX_SIZE_MB=10
LOG_MAX_BACKUPS=3

# Max age in days for rotated files (0 = no age-based deletion)
LOG_MAX_AGE_DAYS=0

LOG_COMPRESS=false

# --- Server-Domme related ---

# Tasks file
TASKS_PATH=./data/default_task.list.json

# Task Protected Users (comma separated)
PROTECTED_USERS=

# Shortlink base url (dont add / at the end)
SHORTLINK_BASE_URL=https://example.com

# Listen address for the shortlink redirect server (host:port). The compose
# file publishes 8787, so changing the port here means changing it there too.
SHORTLINK_ADDR=:8787

# Shallow health endpoint for uptime monitors (empty = disabled)
HEALTHCHECK_PATH=/ping

# --- Chat persona (off by default) ---

# Turning this on sends the contents of opted-in channels to third-party
# relays to produce replies. Channels are opted in one at a time with
# /chat channel — enabling this alone makes her available, not present.
#
# She is one person only if she speaks through one model. Every moment is
# two calls — one to think it through, one to say it — and a pool that hands
# them to a different model each time gives her a different voice each time.
# For a real deployment set CHAT_BASE_URL/CHAT_MODEL (or one CHAT_BACKENDS
# entry) to a single dependable model and turn the relays off. See
# docs/persona.md.
CHAT_ENABLED=false

# Every spelling she answers to, comma separated, most canonical first.
# Whatever Discord calls her — the account name, and any per-guild nickname —
# is added to this automatically, so these are extras rather than the whole
# list. A mention renders as the account name, so a bot named DevBot that is
# told it is only "Dev" will decide DevBot is somebody else.
CHAT_NAME=Domme

# The authored character file: prose, hard limits, and example exchanges.
CHAT_CHARACTER_PATH=./data/character.md

# Free public backends. g4f.space relays donated servers and is the one that
# carries a full character prompt. Pollinations refuses a prompt this size
# anonymously (402 KEY_BUDGET_EXHAUSTED); use CHAT_BASE_URL below if you have
# a key for it.
CHAT_USE_G4F=true
CHAT_USE_POLLINATIONS=false

# How many g4f.space models to keep in the pool. Each is on a different
# donated server, so this is really a count of machines to fall back through.
CHAT_G4F_PICKS=3

# API key for the g4f relay. Without one its free allowance is proof-of-work
# "cakes" baked in a browser and credited to THE IP THAT BAKED THEM — so a
# server has none and every call returns 402 insufficient_credits, no matter
# what you do from your own machine. An account token (g4f.dev/members.html)
# is bound to the account rather than the IP and works from anywhere.
CHAT_G4F_API_KEY=

# Any other OpenAI-compatible endpoint — local Ollama or LM Studio, or a paid
# API. Tried first when set, because naming one is a deliberate choice.
CHAT_BASE_URL=
CHAT_MODEL=
CHAT_API_KEY=

# Any number of further OpenAI-compatible endpoints, comma separated, most
# preferred first. Each entry is name|baseURL|model, with an optional fourth
# field for an API key. The pool fails over between all of them and learns
# which ones actually answer, so more independent endpoints is the whole of
# the resilience story.
#
# QUOTE THE VALUE. It contains pipes, and an unquoted pipe is a shell
# pipeline to anything that sources this file rather than reading it.
#
#   A model on your own machine, with a paid API to fall back to:
#
#     CHAT_BACKENDS="home|http://localhost:11434/v1|llama3.1,paid|https://api.example.com/v1|gpt-4o-mini|sk-xxxx"
#
#   The self-hosted gpt4free, when running under Docker Compose with
#   `--profile g4f`. Port 8080, not the 1337 in the g4f docs — that is a
#   host-side mapping and does not apply inside the compose network:
#
#     CHAT_BACKENDS="g4f|http://g4f:8080/v1|gpt-4o-mini"
#
# Note that most "free AI" sites are web UIs rather than APIs — behind
# Cloudflare, or requiring a signed request — and cannot be used here. An
# endpoint belongs in this list only if it answers POST {base}/chat/completions
# with an OpenAI-shaped body.
CHAT_BACKENDS=

# How the backends above are ordered. "priority" (default) tries them in the
# order given and moves past one only while it is resting after failures —
# her voice comes from the model you chose, and changes only when that one is
# down. "score" ranks them by what they have done lately: resilient, but the
# model answering wanders from call to call. Changeable at runtime with
# /chat backends (bot developer only).
CHAT_BACKEND_ORDER=priority

# Names from CHAT_BACKENDS that her VOICE prefers, in order: the model that
# writes what she says. Thinking (appraisal, reflection, initiative) uses the
# full list. If every voice backend is down she still speaks through the rest.
# Empty: the voice uses the full list too. Changeable with /chat backends.
#
#   CHAT_VOICE_BACKENDS=g4f-1,g4f-3
CHAT_VOICE_BACKENDS=

# How long one backend gets to answer. Raise it for a model running on CPU,
# which can spend most of a minute on a prompt a hosted GPU answers in two
# seconds. The whole attempt is allowed twice this, so failover still has room.
CHAT_REQUEST_TIMEOUT=45s

# The timezone your community keeps, as an IANA name (Europe/Moscow,
# America/New_York). It decides whether it is the middle of the night for the
# people she is talking to, which is not the same question as what time it is
# on the host — a bot yawning through someone's prime time is worse than one
# with no clock at all. Empty means UTC.
CHAT_TIMEZONE=

# Where her memory lives: Markdown files, one directory per server — how she
# sees herself, a file on each person, one file per day, what she means to do.
# Read them, fix them by hand if she has something wrong. It is the one thing
# the bot writes outside its datastore, so under Docker it must be inside the
# mounted data volume or she forgets everything on every deploy.
CHAT_MEMORY_PATH=./data/mind

# The hour, in CHAT_TIMEZONE, after which she looks back on the day before:
# writes what it meant, rewrites how she sees herself and the people in it.
CHAT_REFLECT_HOUR=5

# How freely the backends sample her replies, 0 to 2. Empty leaves each
# backend to its own default, which is what her character was tuned against
# on the public relays. Only her voice uses it: her private thinking is always
# asked at a low temperature, so its judgement is steady. For a local model
# whose default gives the same words every time, around 0.8 to 1.0.
CHAT_TEMPERATURE=

# Odds that a message of hers drops the apostrophes from casual contractions
# ("dont", "im", "thats"), the way people type. Final full stops, em-dashes and
# typographer's quotes are always evened out; this is only the apostrophes.
# 0 keeps them always.
CHAT_CASUAL_SLIPS=0.2

# Whether what she says about herself becomes true of her. Each night her own
# messages from the day before are read for things she said about herself —
# an opinion, a taste, a habit — and kept in me.md beside her memory, so she
# stays the same someone. Jokes and roleplay are meant to be skipped; read
# me.md now and then early on. See docs/persona-v3.md, F2.
CHAT_SELF_FACTS=true

# How many of the character file's example exchanges her voice sees on each
# message, drawn at random. Shown all of them every time, whatever they have in
# common becomes a template; drawn afresh, only the voice stays. 0 shows all.
# Filed under situations ("### jab" in the character file), three in four come
# from the situation in front of her, and 4 does what 8 random ones did.
CHAT_EXAMPLES_SAMPLE=8

# Each reply is held to her style after she writes it: one with a phrase the
# character file lists under "Not her words" is asked for once more, and one
# far longer than her longest example is cut at a sentence. Costs a call only
# when a reply misses. false sends replies as written.
CHAT_STYLE_CHECK=true

# Whether she may go and look into a room she reads before she answers, when
# answering needs it: "hang on" - she puts her head in, comes back with the
# gist, and is away for a moment while she does. Her thinking asks; the code
# decides, and refuses a room she does not read, one she was just in, or a
# fourth look in a day. Off, what she has of those rooms is whatever her last
# walk caught. Needs CHAT_WALKS.
CHAT_LOOK=true

# How many characters one prompt may run to before what she knows starts
# giving way: recalled moments first, then things she has said about herself,
# then her specifics, then the oldest notes on a person. Her persona, the live
# conversation and the person she is answering never give way. Characters, not
# tokens — roughly four to one. The defaults are fitted to the free relays,
# which refuse or time out on long prompts; a model you chose yourself may take
# several times as much. The log line mind_prompt_sized reports every prompt.
CHAT_THINK_BUDGET=16000
CHAT_VOICE_BUDGET=12000

# Whether she may be let into channels Discord marks age-restricted. Off, they
# are closed to her whatever mode they were given: she does not read, walk
# through, answer or speak in one. On, they are ordinary channels — still opted
# in one at a time with /chat channel — and what is said there goes to the
# third-party relays like anything else, which may refuse it. Her own limits
# (the character file's "Avoid") do not change.
CHAT_AGE_RESTRICTED=false

# Something she meant to follow up on with someone ("ask how the interview
# went") comes due the moment they turn up in a room she reads, instead of on
# a timer while they are away. No tag, no consent needed: she is joining a
# room they are in. Counts toward her daily limit of things she starts.
CHAT_FOLLOWUP_ON_SIGHT=true

# In channels set to speaks-first, she notices a remark she overhears because
# it touches something of hers — her specifics, what she has said about
# herself, what she means to do, or someone she has been talking with — rather
# than by chance. Whether she joins is still hers to decide. false restores
# the old random 30%.
CHAT_INTEREST=true

# With CHAT_INTEREST on, the odds she considers an overheard remark that
# touches nothing of hers. 0 in the core design; an experiment switch.
CHAT_SERENDIPITY=0

# The odds that her recall brings back a loosely related memory in place of
# the weakest relevant one — where "that reminds me" comes from. 0 recalls
# strictly by relevance.
CHAT_DRIFT=0.25

# Whether she has a body: sleep that follows from how long she has been awake
# and the time of day, energy for people that talking drains and quiet
# restores, and being online, away or asleep. Away or asleep she shows as idle
# (never invisible), sees what is said, and answers people when she is back.
# REQUIRES CHAT_TIMEZONE — she sleeps by the community's clock, and the chat
# will not start without one. false keeps her always online. Tune the body
# with: go run ./cmd/bodysim
CHAT_BODY=true

# Feelings with a cause that fade on their own clock — "stung, about his jab,
# two hours ago" — in place of a one-line mood overwritten by every message.
# Several at once, heavier ones fading slower; kept in self.md. false restores
# the v2 mood.
CHAT_FEELINGS=true

# Something happens in her between conversations. Every hour or so, and on
# waking, one cheap call works out what is on her mind — usually a thing, not a
# mood — and each night her life and wants are advanced from what actually
# happened. About 15 calls a day; none while she is asleep. false: she exists
# only when spoken to, as in v2.
CHAT_IDLE_MIND=true

# She passes through the channels set to /chat channel mode:reads now and then,
# and keeps the gist of what caught her — never quotes, never tags anyone for
# it, and never speaks there. Do not put channels people vent or confide in on
# reads. false ignores reads channels.
CHAT_WALKS=true

# What she starts comes from the idle mind — something specific she wants to
# say to someone around, or to a room — instead of timers finding a quiet room
# or someone who has been away. The daily limit, consent and presence still
# hold. false restores the v2 timer openings.
CHAT_IMPULSES=true

# In rooms where she only answers, she may react (never speak) to something
# she overhears that touches her. A reaction counts a third of a start toward
# the daily limit.
CHAT_REACT_FIRST=true
