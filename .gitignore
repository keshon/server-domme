.env
# Any local variant (.env.local, .env.bak, ...) may hold a live token.
.env.*
!.env.example
*.exe
*.exe~
/.VSCodeCounter
/assets/media
/data/*_task.list.json
/dist
/tools
datastore.json*

# Datastore directories: WAL, snapshots and the lock file, wherever they live.
# snapshot-*.json is already covered by the *.json rule above.
/data/store/
wal.log
LOCK

# Scratch space for dumps pulled off the production server.
/temp/
*.txt
*private*
datastore_dump.json
*.json
dump.bat
!default_task.list.json
/tmp
/dev
/data/media-plain

/server-domme-discord

/website/node_modules/
/website/dist/
!website/package.json
!website/package-lock.json
!website/docs-nav.json
!website/public/robots.txt
/website/public/assets/.gitkeep
/website/public/assets/about-banner.webp
/website/public/assets/avatar.webp
/website/public/assets/purge/nuke-recurring.webp
/website/public/assets/purge/nuke-upcoming.gif
